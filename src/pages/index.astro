---
import Base from '../layouts/Base.astro';
import OmniFlow from '../components/OmniFlow.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import {
  profile,
  metrics,
  experience,
  companies,
  buildingWith,
  skills,
  helpWith,
  certifications,
  awards,
  recommendations,
  education,
} from '../data/profile';
import { projects } from '../data/projects';

const site = Astro.site!.toString().replace(/\/$/, '');
const apiUrl = `${site}/api/v1/engineers/souradip`;
const title = `${profile.name} | Lead Java Backend Engineer in India`;
const description =
  'Souradip Ganguly is a lead Java backend engineer in Kolkata, India with 6+ years building Spring Boot microservices and distributed systems for telecom, banking and insurance. He leads backend work on British Telecom’s digital ordering platform, on services that handle more than 10 million API calls a month.';

const personId = `${site}/#person`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: site,
      name: profile.name,
      description,
      inLanguage: 'en',
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${site}/#profile`,
      url: site,
      name: title,
      isPartOf: { '@id': `${site}/#website` },
      about: { '@id': personId },
      mainEntity: { '@id': personId },
      dateModified: new Date().toISOString().slice(0, 10),
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      givenName: 'Souradip',
      familyName: 'Ganguly',
      url: site,
      image: `${site}/souradip.jpg`,
      description,
      jobTitle: profile.role,
      worksFor: { '@type': 'Organization', name: companies.bounteous.name, sameAs: companies.bounteous.linkedin },
      address: { '@type': 'PostalAddress', addressLocality: 'Kolkata', addressRegion: 'West Bengal', addressCountry: 'IN' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Narula Institute of Technology' },
      email: `mailto:${profile.email}`,
      sameAs: [profile.linkedin, profile.github],
      hasOccupation: {
        '@type': 'Occupation',
        name: 'Lead Backend Engineer',
        occupationLocation: { '@type': 'Country', name: 'India' },
        skills: skills.flatMap((g) => g.items).join(', '),
        experienceRequirements: '6+ years',
      },
      knowsAbout: [...new Set(['Backend engineering', 'Legacy modernisation', ...skills.filter((g) => g.group !== 'Leadership').flatMap((g) => g.items)])],
      hasCredential: certifications.map((c) => ({ '@type': 'EducationalOccupationalCredential', name: c })),
      award: awards.map((a) => `${a.name}, ${a.from}`),
      subjectOf: projects.map((p) => ({ '@type': 'SoftwareSourceCode', name: p.name, url: `${site}/projects/${p.slug}`, codeRepository: p.repo })),
    },
  ],
};

const nav = [
  { id: 'about', label: 'About' },
  { id: 'impact', label: 'Featured work' },
  { id: 'work', label: 'Experience' },
  { id: 'recognition', label: 'Recognition' },
  { id: 'projects', label: 'Projects' },
  { id: 'skills', label: 'Skills' },
  { id: 'contact', label: 'Contact' },
];

// Messages go through FormSubmit so visitors don't need a mail app set up.
const formAction = `https://formsubmit.co/ajax/${profile.email}`;
---

<Base title={title} description={description} jsonLd={jsonLd} header={false}>
  <div class="spotlight" aria-hidden="true"></div>

  <div class="mobile-bar">
    <a class="mark" href="#top">sg<span>_</span></a>
    <a class="btn primary small" href="#contact">Get in touch</a>
    <ThemeToggle />
  </div>

  <div class="shell" id="top">
    <aside class="side">
      <div class="side-inner">
        <img
          class="avatar"
          src="/souradip-192.webp"
          srcset="/souradip-192.webp 1x, /souradip-384.webp 2x"
          width="96"
          height="96"
          alt={`Photo of ${profile.name}`}
          fetchpriority="high"
        />
        <p class="eyebrow">
          {profile.role} at <a href={companies.bounteous.linkedin} target="_blank" rel="noopener">{companies.bounteous.name}</a>
        </p>
        <h1>{profile.name}</h1>
        <p class="pitch">{profile.pitch}</p>

        <nav class="toc" aria-label="Sections">
          <ol>
            {nav.map((n, i) => (
              <li>
                <a href={`#${n.id}`} data-section={n.id}>
                  <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                  <span class="bar" aria-hidden="true"></span>
                  {n.label}
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="side-foot">
          <p class="status"><span class="dot" aria-hidden="true"></span>{profile.openTo}</p>
          <div class="actions">
            <a class="btn primary" href="#contact">Get in touch</a>
            <a class="btn" href={profile.resume} target="_blank" rel="noopener">Resume</a>
          </div>
          <div class="socials">
            <a href={profile.linkedin} rel="me" target="_blank">LinkedIn</a>
            <a href={profile.github} rel="me" target="_blank">GitHub</a>
            <span class="desk-toggle"><ThemeToggle /></span>
          </div>
        </div>
      </div>
    </aside>

    <div class="content">
      <section id="about" class="block">
        <h2 class="label">About</h2>
        {profile.intro.map((p) => <p class="lead">{p}</p>)}
        <div class="metrics">
          {metrics.map((m) => (
            <div class="metric">
              <p class="value"><span class="count" data-to={m.value}>{m.value}</span>{m.suffix}</p>
              <p class="mlabel">{m.label}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="impact" class="block">
        <h2 class="label">Featured work</h2>
        <h3 class="title">Moving British Telecom's agent and store orders to the digital journey</h3>
        <p class="lead">
          Most orders at British Telecom come through contact centre agents and stores, not the website, and those channels ran on screens that were years behind the digital journey. Rather than rebuilding every legacy tool, I launched one service that sits between them and the new journey, so any channel can hand an order over in a single step.
        </p>
        <OmniFlow />
        <div class="impact-row">
          <p><b>30%+</b> more orders within three months</p>
          <p><b>1 step</b> for any legacy channel to hand over an order</p>
          <p><b>0</b> details typed twice by agents</p>
        </div>
      </section>

      <section id="work" class="block">
        <h2 class="label">Experience</h2>
        <ol class="roles">
          {experience.map((r) => (
            <li class="role">
              <p class="when mono">{r.period} · {r.place}</p>
              <h3>
                {r.title},{' '}
                <a class="co" href={r.company.linkedin} target="_blank" rel="noopener">{r.company.name}</a>
                {r.company.note && <span class="note"> ({r.company.note})</span>}
              </h3>
              <p class="summary">{r.summary}</p>
              <ul class="points">
                {r.points.map((p) => <li>{p}</li>)}
              </ul>
              <ul class="tags">{r.stack.map((s) => <li>{s}</li>)}</ul>
            </li>
          ))}
        </ol>

        <div class="now">
          <p class="eyebrow">Building with now</p>
          <ul class="tags accent">{buildingWith.map((b) => <li>{b}</li>)}</ul>
          <p class="hint">My next open source projects run on these, so the code will be public as I go.</p>
        </div>
      </section>

      <section id="recognition" class="block">
        <h2 class="label">Recognition</h2>
        <h3 class="title">What the people I’ve worked for say</h3>
        {recommendations.length > 0 && (
          <div class="quotes">
            {recommendations.map((r) => (
              <figure class="quote">
                <blockquote>“{r.quote}”</blockquote>
                <figcaption>
                  {r.link ? <a href={r.link} target="_blank" rel="noopener">{r.name}</a> : r.name}
                  <span>{r.title} · {r.relation}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        )}
        <p class="eyebrow sub">Awards along the way</p>
        <ul class="awards">
          {awards.map((a) => (
            <li class="award">
              <svg class="medal" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <circle cx="12" cy="9" r="6"></circle>
                <path d="M8.5 14 7 22l5-3 5 3-1.5-8"></path>
              </svg>
              <p class="aname">{a.name}</p>
              <p class="afrom">{a.from}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="projects" class="block">
        <h2 class="label">Projects</h2>
        <div class="projects">
          {projects.map((p) => (
            <a class="project" href={`/projects/${p.slug}`}>
              <p class="eyebrow">{p.year} · design notes</p>
              <h3>{p.name} <span class="arrow" aria-hidden="true">→</span></h3>
              <p>{p.tagline}</p>
              <ul class="tags">{p.stack.slice(0, 4).map((s) => <li>{s}</li>)}</ul>
            </a>
          ))}
        </div>
        <a class="more" href={`${profile.github}?tab=repositories`} target="_blank" rel="noopener">
          Show more on GitHub <span aria-hidden="true">→</span>
        </a>
      </section>

      <section id="skills" class="block">
        <h2 class="label">Skills</h2>
        <dl class="skills">
          {skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </div>
          ))}
        </dl>
        <div class="extras">
          <div>
            <h3 class="eyebrow">Certifications</h3>
            <ul>{certifications.map((c) => <li>{c}</li>)}</ul>
          </div>
          <div>
            <h3 class="eyebrow">Education</h3>
            <p>{education.degree}<br /><span class="muted">{education.school}, {education.period}</span></p>
          </div>
        </div>
      </section>

      <section id="contact" class="block">
        <h2 class="label">Contact</h2>
        <h3 class="title">Need someone for this kind of work?</h3>
        <p class="lead">Pick what fits, add a line or two, and it lands straight in my inbox.</p>
        <div class="help">
          {helpWith.map((h) => (
            <button class="help-card" type="button" data-topic={h.subject}>
              <h4>{h.title}</h4>
              <p>{h.body}</p>
              <span class="go">Start a conversation →</span>
            </button>
          ))}
        </div>

        <form class="msg" id="msg" action={formAction} method="post">
          <div class="row">
            <label>
              <span>Name</span>
              <input name="name" autocomplete="name" required maxlength="100" />
            </label>
            <label>
              <span>Email</span>
              <input name="email" type="email" autocomplete="email" required maxlength="150" />
            </label>
          </div>
          <label>
            <span>About</span>
            <select name="topic">
              <option>Hello from your portfolio</option>
              {helpWith.map((h) => <option>{h.subject}</option>)}
            </select>
          </label>
          <label>
            <span>Message</span>
            <textarea name="message" rows="5" required maxlength="4000"></textarea>
          </label>
          <input class="trap" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="send">
            <button class="btn primary" type="submit">Send message</button>
            <p class="sent-note" role="status" aria-live="polite"></p>
          </div>
        </form>

        <p class="direct">
          Prefer your own inbox? Write to <span class="mono">{profile.email}</span>
          <button class="copy-mail" type="button" data-copy={profile.email}>Copy</button>
        </p>

        <div class="curl">
          <div class="curl-head">
            <p class="eyebrow">Or ask my API</p>
            <button class="copy" type="button" data-copy={`curl ${apiUrl}`}>Copy</button>
          </div>
          <pre><code><span class="prompt">$</span> curl {apiUrl}</code></pre>
          <p class="hint">
            Returns my experience, stack and contact details as JSON. <a href="/api/v1/engineers/souradip" target="_blank" rel="noopener">Open it in the browser</a>.
          </p>
        </div>
      </section>

      <footer class="foot">
        <p>© {new Date().getFullYear()} {profile.name}. Static site built with Astro, served from Vercel’s edge.</p>
        <p><a href="https://github.com/SouradipG/portfolio" target="_blank" rel="noopener">Source on GitHub</a></p>
      </footer>
    </div>
  </div>
</Base>

<script>
  // Highlight the section currently in view in the side navigation.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.toc a').forEach((a) => links.set(a.dataset.section!, a));
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.classList.remove('active'));
        links.get(e.target.id)?.classList.add('active');
      }
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );
  document.querySelectorAll('.content section[id]').forEach((s) => spy.observe(s));

  // Count the impact numbers up once they scroll into view.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    const counter = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        const to = Number(el.dataset.to);
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / 1100);
          el.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        counter.unobserve(el);
      }
    });
    document.querySelectorAll<HTMLElement>('.count').forEach((el) => {
      el.textContent = '0';
      counter.observe(el);
    });
  }

  // Soft light that follows the pointer on desktop.
  const spot = document.querySelector<HTMLElement>('.spotlight');
  if (spot && !reduced && matchMedia('(pointer: fine)').matches) {
    window.addEventListener('pointermove', (e) => {
      spot.style.setProperty('--x', `${e.clientX}px`);
      spot.style.setProperty('--y', `${e.clientY}px`);
    });
    spot.classList.add('on');
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied';
      } catch (_) {
        btn.textContent = 'Select and copy';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1800);
    }),
  );

  // Contact form: the help cards pick a topic, the form posts over fetch.
  const form = document.querySelector<HTMLFormElement>('#msg');
  if (form) {
    const note = form.querySelector<HTMLElement>('.sent-note')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    document.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach((card) =>
      card.addEventListener('click', () => {
        form.querySelector<HTMLSelectElement>('select')!.value = card.dataset.topic!;
        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        form.querySelector<HTMLTextAreaElement>('textarea')!.focus({ preventScroll: true });
      }),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      if (data._honey) return;
      submit.disabled = true;
      note.className = 'sent-note';
      note.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            name: data.name,
            email: data.email,
            message: data.message,
            _subject: `${data.topic} (from ${data.name})`,
            _replyto: data.email,
            _template: 'table',
            _captcha: 'false',
          }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || String(body.success) === 'false') throw new Error();
        form.reset();
        note.classList.add('ok');
        note.textContent = 'Thanks, your message is in my inbox. I’ll get back to you soon.';
      } catch (_) {
        note.classList.add('err');
        note.textContent = 'That didn’t go through. Please copy my email below and write to me directly.';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .spotlight {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.4s;
    background: radial-gradient(520px circle at var(--x, 50%) var(--y, 30%), var(--glow), transparent 70%);
  }
  .spotlight.on {
    opacity: 1;
  }

  .mobile-bar {
    display: none;
  }

  .shell {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: 4rem;
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .side {
    position: relative;
  }
  .side-inner {
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 5rem 0 3rem;
  }
  .eyebrow a {
    color: var(--accent);
    text-decoration: none;
  }
  .eyebrow a:hover {
    text-decoration: underline;
  }
  .avatar {
    display: block;
    box-sizing: content-box;
    width: 96px;
    height: 96px;
    margin-bottom: 1.25rem;
    padding: 4px;
    border: 1px solid var(--accent);
    border-radius: 50%;
  }
  h1 {
    font-size: clamp(2.4rem, 4.2vw, 3.3rem);
    margin: 0.6rem 0 0.8rem;
    letter-spacing: -0.02em;
  }
  .pitch {
    font-size: 1.2rem;
    line-height: 1.45;
    max-width: 24rem;
    color: var(--ink);
  }

  .toc {
    margin-top: 2.75rem;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--faint);
  }
  .toc .idx {
    font-family: var(--mono);
    font-size: 0.72rem;
  }
  .toc .bar {
    display: inline-block;
    width: 2rem;
    height: 1px;
    background: currentColor;
    transition: width 0.2s;
  }
  .toc a:hover,
  .toc a.active {
    color: var(--ink);
  }
  .toc a:hover .bar,
  .toc a.active .bar {
    width: 4rem;
    background: var(--accent);
  }

  .side-foot {
    margin-top: auto;
    padding-top: 2.5rem;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.22);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.4rem 0 1.25rem;
  }
  .socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.92rem;
  }
  .socials a {
    color: var(--muted);
    text-decoration: none;
  }
  .socials a:hover {
    color: var(--accent);
  }
  .desk-toggle {
    margin-left: auto;
  }

  .content {
    padding: 5rem 0 2rem;
  }
  .block {
    padding-bottom: 5rem;
    scroll-margin-top: 2rem;
  }
  .label {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .title {
    font-size: 1.55rem;
    margin-bottom: 0.75rem;
  }
  .lead {
    color: var(--muted);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 2rem;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .metric {
    padding: 1.25rem 1.25rem 1.1rem;
    background: var(--surface);
  }
  .value {
    margin: 0;
    font-family: var(--mono);
    font-size: 2rem;
    font-weight: 500;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .mlabel {
    margin: 0.2rem 0 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .impact-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .impact-row p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .impact-row b {
    display: block;
    font-family: var(--mono);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--ink);
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .role {
    position: relative;
    padding: 0 0 2.25rem 1.5rem;
    border-left: 1px solid var(--line);
  }
  .role::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.45rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .when {
    margin: 0 0 0.25rem;
    font-size: 0.8rem;
    color: var(--faint);
  }
  .role h3 {
    font-size: 1.12rem;
  }
  .co {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .co:hover {
    border-bottom-color: var(--accent);
  }
  .note {
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--faint);
  }
  .summary {
    color: var(--muted);
    margin: 0.35rem 0 0.75rem;
  }
  .points {
    margin-bottom: 1rem;
  }
  .points li {
    margin-bottom: 0.45rem;
  }
  .points li::marker {
    color: var(--faint);
  }

  .now {
    margin-top: 0.5rem;
