---
import { profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href="/" aria-label={`${profile.name}, home`}>
      <span class="mono">sg</span><span class="cursor" aria-hidden="true">_</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a class="resume" href={profile.resume} target="_blank" rel="noopener">Resume</a></li>
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>


<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--bg-glass);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.75rem;
  }
  .mark {
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .cursor {
    color: var(--accent);
    animation: blink 1.2s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    padding: 0;
    font-size: 0.93rem;
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover {
    color: var(--ink);
  }
  nav .resume {
    color: var(--accent);
    font-weight: 500;
  }
  @media (max-width: 640px) {
    nav li:not(:last-child) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
