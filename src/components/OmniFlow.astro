---
// Animated picture of the order handover service: orders start in the legacy
// channels, the service captures context once, and the agent lands in the
// modern order journey.
const sources = ['Contact centre desktop', 'Service desk tools', 'Retail store systems', 'Other legacy apps'];

const rowH = 58;
const top = 20;
const srcX = 10;
const srcW = 190;
const hubX = 270;
const hubW = 170;
const outX = 510;
const outW = 170;
const height = top * 2 + rowH * sources.length - 18;
const mid = height / 2;

const paths = sources.map((_, i) => {
  const y = top + i * rowH + 20;
  return `M${srcX + srcW} ${y} C ${srcX + srcW + 40} ${y}, ${hubX - 40} ${mid}, ${hubX} ${mid}`;
});
const outPath = `M${hubX + hubW} ${mid} L${outX} ${mid}`;

// Narrow screens get a top to bottom version so the labels stay readable.
const short = ['Contact centre', 'Service desk', 'Store systems', 'Legacy apps'];
const tW = 340;
const cellW = 155;
const cells = short.map((t, i) => ({ t, x: i % 2 === 0 ? 10 : tW - 10 - cellW, y: 10 + Math.floor(i / 2) * 52 }));
const tHubY = 150;
const tOutY = 270;
const tPaths = cells.map((c) => `M${c.x + cellW / 2} ${c.y + 38} C ${c.x + cellW / 2} ${tHubY - 20}, ${tW / 2} ${tHubY - 30}, ${tW / 2} ${tHubY}`);
const tOut = `M${tW / 2} ${tHubY + 76} L${tW / 2} ${tOutY}`;
---

<figure class="omni">
  <svg class="wide" viewBox={`0 0 690 ${height}`} role="img" aria-labelledby="omni-title omni-desc">
    <title id="omni-title">How the order handover works</title>
    <desc id="omni-desc">Orders start in legacy channels such as the contact centre desktop, service desk tools and retail store systems. One service captures the customer context once and hands the agent into the modern digital order journey, which reads that context at every step.</desc>

    {paths.map((d) => <path class="wire" d={d} />)}
    <path class="wire out" d={outPath} />

    {sources.map((s, i) => (
      <g class="node legacy">
        <rect x={srcX} y={top + i * rowH} width={srcW} height="40" rx="7" />
        <text x={srcX + srcW / 2} y={top + i * rowH + 20}>{s}</text>
      </g>
    ))}

    <g class="node hub">
      <rect x={hubX} y={mid - 42} width={hubW} height="84" rx="10" />
      <text x={hubX + hubW / 2} y={mid - 10} class="strong">Order handover</text>
      <text x={hubX + hubW / 2} y={mid + 10} class="strong">Service</text>
      <text x={hubX + hubW / 2} y={mid + 29} class="small">context captured once</text>
    </g>

    <g class="node modern">
      <rect x={outX} y={mid - 42} width={outW} height="84" rx="10" />
      <text x={outX + outW / 2} y={mid - 10} class="strong">Digital order</text>
      <text x={outX + outW / 2} y={mid + 10} class="strong">journey</text>
      <text x={outX + outW / 2} y={mid + 29} class="small">far fewer clicks</text>
    </g>

    {paths.map((d, i) => (
      <circle class="packet" r="4">
        <animateMotion dur="2.6s" begin={`-${i * 0.65}s`} repeatCount="indefinite" path={d} />
      </circle>
    ))}
    {[0, 1, 2].map((i) => (
      <circle class="packet out" r="4.5">
        <animateMotion dur="1.3s" begin={`-${i * 0.43}s`} repeatCount="indefinite" path={outPath} />
      </circle>
    ))}
  </svg>

  <svg class="tall" viewBox={`0 0 ${tW} ${tOutY + 80}`} aria-hidden="true">
    {tPaths.map((d) => <path class="wire" d={d} />)}
    <path class="wire out" d={tOut} />
    {cells.map((c) => (
      <g class="node legacy">
        <rect x={c.x} y={c.y} width={cellW} height="38" rx="7" />
        <text x={c.x + cellW / 2} y={c.y + 19}>{c.t}</text>
      </g>
    ))}
    <g class="node hub">
      <rect x={tW / 2 - 110} y={tHubY} width="220" height="76" rx="10" />
      <text x={tW / 2} y={tHubY + 26} class="strong">Order handover service</text>
      <text x={tW / 2} y={tHubY + 50} class="small">context captured once</text>
    </g>
    <g class="node modern">
      <rect x={tW / 2 - 110} y={tOutY} width="220" height="76" rx="10" />
      <text x={tW / 2} y={tOutY + 26} class="strong">Digital order journey</text>
      <text x={tW / 2} y={tOutY + 50} class="small">fewer screens, fewer clicks</text>
    </g>
    {tPaths.map((d, i) => (
      <circle class="packet" r="4">
        <animateMotion dur="2.2s" begin={`-${i * 0.55}s`} repeatCount="indefinite" path={d} />
      </circle>
    ))}
    {[0, 1].map((i) => (
      <circle class="packet out" r="4.5">
        <animateMotion dur="1.1s" begin={`-${i * 0.55}s`} repeatCount="indefinite" path={tOut} />
      </circle>
    ))}
  </svg>
  <figcaption>
    <span><b>1</b> The agent starts in the legacy tool they already use, which calls the create session API with the customer context.</span>
    <span><b>2</b> The service keeps that context and sends the agent straight into the digital order journey.</span>
    <span><b>3</b> Every step of the order journey reads what it needs through the service, so nothing is typed twice.</span>
  </figcaption>
</figure>

<script>
  // Freeze the moving packets for people who prefer reduced motion.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('.omni svg').forEach((svg) => {
      svg.pauseAnimations();
      svg.setCurrentTime(1.2);
    });
  }
</script>

<style>
  .omni {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background-color: var(--code-bg);
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 18px 18px;
    padding: 1.25rem 1rem 1rem;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .tall {
    display: none;
    max-width: 360px;
    margin: 0 auto;
  }
  .wire {
    fill: none;
    stroke: var(--faint);
    stroke-width: 1.4;
    stroke-dasharray: 4 5;
  }
  .wire.out {
    stroke: var(--accent);
    stroke-dasharray: none;
    stroke-width: 2;
  }
  .node rect {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 1.3;
  }
  .legacy rect {
    stroke-dasharray: 3 3;
  }
  .hub rect {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .modern rect {
    fill: var(--accent-soft);
    stroke: var(--accent);
  }
  text {
    fill: var(--ink);
    font-family: var(--mono);
    font-size: 12.5px;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .legacy text {
    fill: var(--muted);
  }
  .strong {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 15px;
  }
  .small {
    font-size: 10.5px;
    fill: var(--muted);
  }
  .packet {
    fill: var(--faint);
  }
  .packet.out {
    fill: var(--accent);
  }
  figcaption {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.5;
  }
  figcaption b {
    display: inline-grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    margin-right: 0.35rem;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.75rem;
  }
  @media (max-width: 640px) {
    .omni {
      padding: 0.75rem 0.5rem;
    }
    .wide {
      display: none;
    }
    .tall {
      display: block;
    }
    figcaption {
      grid-template-columns: 1fr;
      padding: 0 0.4rem;
    }
  }
</style>
