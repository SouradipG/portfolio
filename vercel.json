{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "portfolio-souradipg.vercel.app" }],
      "destination": "https://portfolio-souradip.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/api/v1/engineers/souradip", "destination": "/api/v1/engineers/souradip.json" }],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
